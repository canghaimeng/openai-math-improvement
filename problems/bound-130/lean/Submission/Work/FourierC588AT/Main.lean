/-! Main results. Provide formula for the order besides the existential specification. -/
theorem transform_main_orderC588AT : ∃ order solve W,
    DFTProgram order solve W ∧ TimeBoundsC588AT W ∧
    ∀ n, 0<n → (run order n).val = receipt n ∧ (run order n).val < 8*n^3 := by
  obtain ⟨o,s,a,b,hp,ho⟩ := flagshipOneC588AT
  exact ⟨o,s,lunchC588AT a b id,hp,Skies.time_boundC588AT (N:=id) (fun n => ⟨le_rfl,by dsimp; omega⟩)
    a b,fun n hn => ⟨ho n hn,(ho n hn).symm ▸ (receipt_bound n hn).2⟩⟩

theorem convolution_main_orderC588AT : ∃ order solve W,
    ConvProgram order solve W ∧ TimeBoundsC588AT W ∧
    ∀ n, 0<n → (run order n).val = receipt (2*n-1) ∧ (run order n).val < 8*(2*n-1)^3 := by
  obtain ⟨o,s,a,b,hp,ho⟩ := flagshipBothC588AT
  have h (n : ℕ) : n ≤ stretchC588AT n ∧ stretchC588AT n ≤ 2*n := by unfold stretchC588AT; omega
  exact ⟨o,s,lunchC588AT a b stretchC588AT,hp,Skies.time_boundC588AT h a b,fun n hn =>
    ⟨ho n hn,(ho n hn).symm ▸ (receipt_bound _ (stretch_posC588AT hn)).2⟩⟩

/-- **The discrete Fourier transform of every length in `O(n (log n)^(1 - 63/50000))`.**
OpenAI's `transform_main` (one fixed program, OpenAI's own `DFTProgram`, `paperTime` and `nlogn`)
with the decimal exponent `1 - 1/10^13` replaced by `decimalExponentC588AT = 1 - 63/50000`
(Work/FourierC588AT/Goal.lean). Sibling of the Walsh-Hadamard theorem `wht_main_block_C588ATx`: both
follow from one kernel program, `RAM.hillsC588AT_program` (Work/FourierC588AT/Seam.lean). -/
theorem transform_mainC588AT : DFTGoalC588AT :=
  let ⟨o,s,W,h,g,_⟩ := transform_main_orderC588AT
  ⟨o,s,W,h,g⟩

/-- **Convolution of every length with the same bounds** (OpenAI's `convolution_main`, same change). -/
theorem convolution_mainC588AT : ConvGoalC588AT :=
  let ⟨o,s,W,h,g,_⟩ := convolution_main_orderC588AT
