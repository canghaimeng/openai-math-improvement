lemma multiplier_rangeC588AT : 1 < paperMultiplier ∧ paperMultiplier < paperM := by
  norm_num [paperMultiplier,paperM,paperDelta,paperW]

lemma theta_ltC588AT : theta < 1 := by
  have h := multiplier_rangeC588AT
  have hg : 0<log paperM := Real.log_pos (lt_trans h.1 h.2)
  rw [theta,div_lt_iff₀ hg,one_mul]
  exact Real.log_lt_log (by linarith) h.2

lemma alpha_thetaC588AT : alphaC588AT < theta := by
  let d : ℝ := 1261/(10:ℝ)^6
  have hp : 0<d := by dsimp [d]; norm_num
  have hm : 2 ≤ paperM := by norm_num [paperM]
  have hx : 0<paperMultiplier := lt_trans zero_lt_one multiplier_rangeC588AT.1
  have hu : 0<paperM := by linarith
  have h2 := (Real.log_le_log (by norm_num : 0 < (2:ℝ)) hm)
  have he := log2_minC588AT
  have hh : 0<log paperM := by linarith
  have hk := Real.log_le_sub_one_of_pos (show 0<paperM/paperMultiplier by positivity)
  rw [log_div hu.ne' hx.ne'] at hk
  have H : paperM/paperMultiplier-1 < d*(2/3) := by
    norm_num [d,paperM,paperMultiplier,paperW,paperDelta]
  rw [theta,lt_div_iff₀ hh]
  change (1-d)*log paperM < log paperMultiplier
  have H' := mul_le_mul_of_nonneg_left (he.trans h2) hp.le
  have hy := hk.trans_lt (lt_of_lt_of_le H H')
  rw [sub_mul,one_mul]
  linarith only [hy]

lemma decimal_rangeC588AT : alphaC588AT < decimalExponentC588AT ∧ decimalExponentC588AT < 1 := by
  norm_num [decimalExponentC588AT,alphaC588AT]

def speedC588AT (v : ℝ) (n : ℕ) := (n:ℝ)*(TmC588AT n)^v

lemma flight_littleC588AT {v : ℝ} (h : alphaC588AT < v) :
    flightC588AT =o[atTop] speedC588AT v := by
  rw [isLittleO_iff]
  intro c hc
  filter_upwards [TtopC588AT.eventually_ge_atTop 1,dwarfC588AT TtopC588AT 2
    (p:=v-alphaC588AT) (sub_pos.mpr h) hc] with n hn hh
  have he : 0<TmC588AT n := by linarith
  change ‖(n:ℝ)*TmC588AT n^alphaC588AT*QmC588AT n^2‖ ≤ c*‖(n:ℝ)*TmC588AT n^v‖
  rw [Real.norm_of_nonneg (by positivity),Real.norm_of_nonneg (by positivity)]
  calc
    _ ≤ ((n:ℝ)*TmC588AT n^alphaC588AT)*(c*TmC588AT n^(v-alphaC588AT)) :=
      mul_le_mul_of_nonneg_left hh (by positivity)
    _ = c*((n:ℝ)*(TmC588AT n^alphaC588AT*TmC588AT n^(v-alphaC588AT))) := by ring
    _ = _ := by rw [← rpow_add he, show alphaC588AT + (v-alphaC588AT)=v by ring] -- a+(v-a)

lemma speed_littleC588AT {u v : ℝ} (h : u < v) :
    speedC588AT u =o[atTop] speedC588AT v := by
  rw [isLittleO_iff]
  intro c hc
  filter_upwards [TtopC588AT.eventually_ge_atTop 1,dwarfC588AT TtopC588AT 0
    (p:=v-u) (sub_pos.mpr h) hc] with n hn hh
  have he : 0<TmC588AT n := by linarith
  change ‖(n:ℝ)*TmC588AT n^u‖ ≤ c*‖(n:ℝ)*TmC588AT n^v‖
  rw [Real.norm_of_nonneg (by positivity),Real.norm_of_nonneg (by positivity)]
  have hh' : 1 ≤ c * TmC588AT n^(v-u) := by simpa only [pow_zero] using hh
  calc
    _ = ((n:ℝ)*TmC588AT n^u)*1 := by ring
    _ ≤ ((n:ℝ)*TmC588AT n^u)*(c*TmC588AT n^(v-u)) := mul_le_mul_of_nonneg_left hh' (by positivity)
    _ = c*((n:ℝ)*(TmC588AT n^u*TmC588AT n^(v-u))) := by ring
    _ = _ := by rw [← rpow_add he, show u+(v-u)=v by ring]

theorem decimal_littleC588AT : decimalTimeC588AT =o[atTop] nlogn := by
  have H := speed_littleC588AT decimal_rangeC588AT.2
  have h : speedC588AT 1 = nlogn := funext fun n => by rw [speedC588AT,Real.rpow_one]; rfl
  rw [h] at H; exact H

lemma speed_paperC588AT : speedC588AT theta =O[atTop] paperTime := by
  rw [isBigO_iff]
  refine ⟨1,?_⟩
  filter_upwards [TtopC588AT.eventually_ge_atTop 1,QtopC588AT.eventually_ge_atTop 1] with n hn hh
  have he : 0<TmC588AT n := by linarith
  have he' : 0<QmC588AT n := by linarith
  change ‖(n:ℝ)*TmC588AT n^theta‖ ≤ 1*‖(n:ℝ)*TmC588AT n^theta*QmC588AT n^(4-theta)‖
  rw [Real.norm_of_nonneg (by positivity),Real.norm_of_nonneg (by positivity),one_mul]
  have hb := Real.one_le_rpow hh (show 0 ≤ 4-theta by linarith [theta_ltC588AT])
  exact le_mul_of_one_le_right (by positivity) hb

lemma time_boundC588AT {N} (h : ∀ n:ℕ,n ≤ N n ∧ N n ≤ 2*n) (a b : RationC588AT) :
    TimeBoundsC588AT (lunchC588AT a b N) := by
  have H := lunch_bigC588AT a b h
  have hp := H.trans_isLittleO (flight_littleC588AT alpha_thetaC588AT)
  have hd := H.trans_isLittleO (flight_littleC588AT decimal_rangeC588AT.1)
  have ht : (fun n => (lunchC588AT a b N n:ℝ)) =O[atTop] decimalTimeC588AT := hd.isBigO
  exact ⟨hp.isBigO.trans speed_paperC588AT,ht,ht.trans_isLittleO decimal_littleC588AT⟩

