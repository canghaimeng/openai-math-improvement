lemma Dry.linearPowC588AT (h : b.Grain N k) (g : Small N k) {z : ι→ℂ} (hz : b.Dry N sc z) :
    b.Dry N sc fun i => z i^k i := by
  let V (i : ι) (j : ℕ) : T sc := z i^j
  have F := Instant.climbs b k V (t:=sc)
  refine cycleG h g V (one.congr fun i => (pow_zero _).symm)
    (((Dry.token b k N V (t:=sc)).mul (hz.transfer F)).congr fun i => (pow_succ _ _).symm)

-- polynomial direct branch, N^d
lemma Dry.direC588AT (h : b.Nick N)
    {x : ι→Line} {cl} (hx : b.Dry N (a (c cl)) fun i => Tape.tab (N i) (x i))
    {z : ι→ℂ} (hz : b.Dry N sc z) :
    b.Dry N (a (c cl)) fun i => Tape.tab (N i) (freq (N i) (z i) (x i)) := by
  let D := b.scan N
  have H := Small.self N
  have F := Instant.scan b N
  let K (i : During N) := N i.i
  let V (i : During N) (j : ℕ) : T (c cl) :=
    ∑ k ∈ range j, z i.i^(i.j*k)*x i.i k
  have hk : D.Grain K K := (h.transfer F).grain _
  have G := Instant.climbs D K V (t:=c cl)
  have hj := ((chop h).grain K).transfer G
  have hp := strideG hk V
  have hA : Small (fun i : During K => K i.i) fun i => i.i.j*i.j :=
    (((Small.self K).pow 2).reindex _).mono fun i => by
      rw [pow_two]
      exact Nat.mul_le_mul i.i.hj.le i.hj.le
  have ht := (linearPowC588AT (hj.mul hp) hA (hz.transfer (G.next F))).mul
    (Dry.pick (t:=c cl) (x:=fun (i : During K) j => x i.i.i j)
      (n:=fun i : During K => N i.i.i) (k:=During.j)
      (hx.transfer (G.next F)) hp.dry During.hj)
  exact arrayG (h.grain N) H _ (cycleG hk (Small.self K) V (by
    simp only [V,range_zero,sum_empty]; exact PolyCan.zero)
    (Dry.congr (b:=D.climbs K _ V) (S:=fun (i : During K) => K i.i) (t:=c cl)
      (PolyCan.add (Dry.token D K K V (t:=c cl)) ht) fun i => (sum_range_succ ..).symm))

def fairwindC588AT (d n : ℕ) := surfC588AT d n (stackN n) +
  (if Ports n then 0 else (n+2)^d)

lemma fairwind_degC588AT {c d : ℕ} (n : ℕ) (h : c≤d) : fairwindC588AT c n≤fairwindC588AT d n := by
  unfold fairwindC588AT
  refine add_le_add (surf_degC588AT _ _ h) ?_
  split
  · exact le_rfl
  · exact Small.pow_mono_degree n h
lemma fairwind_leftC588AT (n d : ℕ) : n + (stackN n+2)^d ≤ fairwindC588AT d n := by unfold fairwindC588AT surfC588AT; omega
lemma fairwind_nC588AT (n d : ℕ) : n≤fairwindC588AT d n := (Nat.le_add_right _ _).trans (fairwind_leftC588AT n d)

def BreezyC588AT (b : Bench m ι) (n : ι→ℕ) (t : Ty) (x : ι→T t) : Prop :=
  ∃ d : ℕ,b.Moves (fun i => fairwindC588AT d (n i)) t x

namespace BreezyC588AT
variable {x y : ι→T t}
lemma of_moves {W} (h : b.Moves W t x) (g : Dom n W) : b.BreezyC588AT n t x :=
  ⟨0,h.weaken ((Dom.of_le fun i => fairwind_nC588AT (n i) 0).trans g)⟩
lemma congr (h : b.BreezyC588AT n t x) (g : ∀ i, x i=y i) : b.BreezyC588AT n t y :=
  let ⟨d,hd⟩ := h
  ⟨d,hd.congr g⟩
lemma pair {v : ι→T s} (h : b.BreezyC588AT n t x) (g : b.BreezyC588AT n s v) :
    b.BreezyC588AT n (p t s) fun i => (x i,v i) :=
  let ⟨d,hd⟩ := h
  let ⟨l,hl⟩ := g
  ⟨d+l, (hd.weaken (Dom.of_le fun i => fairwind_degC588AT (n i) (by omega))).pair
    (hl.weaken (Dom.of_le fun i => fairwind_degC588AT (n i) (by omega)))⟩
lemma bind {v : ι→T s} (h : b.BreezyC588AT n t x) (g : (b.extend t x).BreezyC588AT n s v) :
    b.BreezyC588AT n s v :=
  let ⟨d,hd⟩ := h
  let ⟨l,hl⟩ := g
  ⟨d+l, caseM (hd.weaken (Dom.of_le fun i => fairwind_degC588AT (n i) (by omega)))
    (hl.weaken (Dom.of_le fun i => fairwind_degC588AT (n i) (by omega)))⟩
lemma flagtest {f : ι→ℕ} (h : b.BreezyC588AT n w f)
    (g : (b.along (Subtype.val (p:=fun i => f i = 0))).BreezyC588AT (fun i => n i.val) t fun i => x i.val)
    (j : (b.along (Subtype.val (p:=fun i => f i ≠ 0))).BreezyC588AT (fun i => n i.val) t fun i => x i.val) :
    b.BreezyC588AT n t x := by
  obtain ⟨d,hd⟩ := h
  obtain ⟨l,hl⟩ := g
  obtain ⟨k,hk⟩ := j
  let s := d+l+k
  refine ⟨s,Can.testz (W:=fun i => fairwindC588AT s (n i)) (n:=f) ?_ ?_ ?_⟩
  · exact Can.mono hd (fun i => fairwind_degC588AT _ (by unfold s; omega))
  · exact Can.mono hl (fun i => fairwind_degC588AT _ (by unfold s; omega))
  · exact Can.mono hk (fun i => fairwind_degC588AT _ (by unfold s; omega))
end BreezyC588AT

lemma Neaps.courseC588AT (h : b.Neaps (fun i => stackN (n i)) n)
    (hz : b.Moves (fun _ => 0) sc fun i => root (receipt (n i)))
    (r : Bool) {x : ι→Line} {cl} (hx : b.Moves (fun _ => 0) (a (c cl)) fun i =>
      Tape.tab (n i) (x i)) :
    b.BreezyC588AT n (a (c cl)) fun i => Tape.tab (n i) (freq (n i) (pr r (n i)) (x i)) := by
  let f (i : ι) := if Ports (n i) then 0 else 1
  have HH : b.BreezyC588AT n w f := by
    obtain ⟨d,hd⟩ := h.portG.dry
    exact ⟨d,hd.mono fun i => (Nat.le_add_left _ _).trans (fairwind_leftC588AT _ d)⟩
  refine BreezyC588AT.flagtest HH ?_ ?_
  · let P i := f i=0
    have F := Instant.along b (Subtype.val (p:=P))
    have hp : ∀ i : Subtype P, Ports (n i.val) := fun i => by
      by_contra k; have hi : f i.val=0 := i.property; simp [f,k] at hi
    obtain ⟨d,hd⟩ := (h.transfer F).swiftC588AT hp ((hz.transfer F).dunes _) r (hx.transfer F)
    exact ⟨d,hd.weaken (Dom.of_le fun i => Nat.le_add_right _ _)⟩
  · let P i := f i≠0
    have F := Instant.along b (Subtype.val (p:=P))
    have hp : ∀ i : Subtype P, ¬ Ports (n i.val) := fun i g => i.property (by simp [f,g])
    let H := h.transfer F
    have ht := signPC588AT r H.pos ((hz.transfer F).dunes (fun i => n i.val) |>.congr
      (y:=fun i : Subtype P => root (n i.val)) fun i => by rw [receipt,ite_eq_right (hp i)])
    obtain ⟨d,hd⟩ := Dry.direC588AT H.num ((hx.transfer F).dunes _) ht
    exact ⟨d,Can.mono hd (fun i => by unfold fairwindC588AT; rw [ite_eq_right (hp i)]; exact Nat.le_add_left _ _)⟩

lemma Nick.landOrderC588AT (h : b.Nick N) (g : ∀ i, 0<N i) :
    b.BreezyC588AT N w fun i => receipt (N i) :=
  let ⟨d,hd⟩ := h.planOrder g
  ⟨d, hd.weaken (Dom.of_le fun i => fairwind_leftC588AT (N i) d)⟩
lemma Nick.landC588AT (h : b.Nick N) (g : ∀ i, 0<N i)
    (hz : b.Moves (fun _ => 0) sc fun i => root (receipt (N i)))
    (r : Bool) {x : ι→Line} {cl} (hx : b.Moves (fun _ => 0) (a (c cl)) fun i =>
      Tape.tab (N i) (x i)) :
    b.BreezyC588AT N (a (c cl)) fun i => Tape.tab (N i) (freq (N i) (pr r (N i)) (x i)) := by
  obtain ⟨hu,hk⟩ := h.stackH g
  have H := Instant.extend b (fun i => stackN (N i)) (t:=w)
  exact (BreezyC588AT.of_moves hu (Dom.self N)).bind (hk.courseC588AT (hz.transfer H) r (hx.transfer H))
lemma Nick.land'C588AT (h : b.Nick N) (g : ∀ i, 0<N i)
    (hz : b.Moves (fun _ => 0) sc fun i => root (receipt (N i)))
    (r : Bool) {x : ι→Line} {cl} (hx : b.BreezyC588AT N (a (c cl)) fun i =>
      Tape.tab (N i) (x i)) :
    b.BreezyC588AT N (a (c cl)) fun i => Tape.tab (N i) (freq (N i) (pr r (N i)) (x i)) := by
  let V (i : ι) : T (a (c cl)) := Tape.tab (N i) (x i)
  have F := Instant.extend b V (t:=a (c cl))
  exact hx.bind ((h.transfer F).landC588AT g (hz.transfer F) r (x:=x) (cherry b V (t:=a (c cl))))
