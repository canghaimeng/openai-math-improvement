namespace OAI

namespace PowerSaving
noncomputable section
open RAM RAM.Ty Filter Asymptotics

def decimalExponentC588AT : ℝ := 1 - 63/(50000:ℕ)

def decimalTimeC588AT (n : ℕ) : ℝ := (n:ℝ) * (Real.log (n:ℝ)) ^ decimalExponentC588AT

/-- Thm 1 (intro main) and decimal corollary estimates. -/
def TimeBoundsC588AT (W : ℕ → ℕ) : Prop :=
  let W' := fun n : ℕ => (W n : ℝ)
  W' =O[atTop] paperTime ∧ W' =O[atTop] decimalTimeC588AT ∧ W' =o[atTop] nlogn

def DFTGoalC588AT : Prop := ∃ order solve W, DFTProgram order solve W ∧ TimeBoundsC588AT W

def ConvGoalC588AT : Prop := ∃ order solve W, ConvProgram order solve W ∧ TimeBoundsC588AT W

end
